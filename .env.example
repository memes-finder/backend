# Database Configuration
DB_HOST=mysql
DB_USER=memes_user
DB_PASSWORD=memes_password
DB_NAME=memes_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INDEX=0

# AWS S3 Configuration (for image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=

# Google API Configuration
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# OpenAI Configuration
OPENAI_API_KEY=

# Tenor API
TENOR_API_KEY=

# Admin Configuration
ADMIN_TOKEN=your_secure_admin_token_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Use 'localhost' when running services on the same machine
STEMMER_HOST=host.docker.internal
# Use 'localhost' when running services on the same machine
SEARCH_HOST=search

# Python services
# Meme Search Engine Environment Configuration
# Copy this file to .env and customize for your environment

# Device configuration
# Use 'cpu' for CPU-only systems
PYTHON_DEVICE=cuda

# Model configurations
EMBEDDING_DIM=1024
LLAVA_MODEL=llava-hf/llava-1.5-7b-hf
TEXT_MODEL=intfloat/multilingual-e5-large
STEMMER_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
CLIP_MODEL=ViT-B/32
CLIP_EMBEDDING_DIM=512
TEXT_EMBEDDING_DIM=768

# Processing configurations
BATCH_SIZE=32
VIDEO_FRAME_COUNT=5
VIDEO_TARGET_DURATION=3

# Redis configurations
# Use 'localhost' for local dev, 'redis' for Docker networks
REDIS_SEARCH_DB=1
REDIS_MAX_CONNECTIONS=20
CACHE_TTL=86400  # 24 hours
REDIS_INDEX_NAME=meme_idx

# Server configurations
STEMMER_PORT=5050
SEARCH_PORT=5051
SERVER_HOST=0.0.0.0

# Search configurations
DEFAULT_SEARCH_LIMIT=20
VECTOR_SCORE_WEIGHT=0.8
EMOTION_SCORE_WEIGHT=0.2

# Arabic meme-related terms (comma-separated)
ARABIC_MEME_TERMS=ميم,مضحك,تحشيش

# Debug mode
DEBUG=False
