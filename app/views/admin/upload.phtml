        </div>
    <?php endif; ?>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('uploadForm');
    const fileInput = form.querySelector('input[type="file"]');
    const progressDiv = document.getElementById('uploadProgress');
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    const uploadStatus = document.getElementById('uploadStatus');
    const uploadList = document.getElementById('uploadList');
    const maxChunkSize = 5 * 1024 * 1024; // 5MB chunks
    let statusCheckInterval;

    function generateFileId() {
        return Date.now() + '-' + Math.random().toString(36).substr(2, 9);
    }

    async function uploadChunk(file, chunkNumber, totalChunks, fileId) {
        const start = chunkNumber * maxChunkSize;
        const end = Math.min(start + maxChunkSize, file.size);
        const chunk = file.slice(start, end);

        const formData = new FormData();
        formData.append('chunk', chunk, 'chunk');
        formData.append('fileId', fileId);
        formData.append('totalChunks', totalChunks);
        formData.append('chunkNumber', chunkNumber);
        formData.append('originalName', file.name);
        formData.append('mimeType', file.type);

        const response = await fetch('/admin/uploadChunk', {
            method: 'POST',
            body: formData
        });

        if (!response.ok) {
            throw new Error('Upload failed');
        }

        return response.json();
    }

    async function uploadFile(file) {
        const totalChunks = Math.ceil(file.size / maxChunkSize);
        const fileId = generateFileId();

        progressText.textContent = `Starting upload of ${file.name}...`;

        for (let chunkNumber = 0; chunkNumber < totalChunks; chunkNumber++) {
            const progress = ((chunkNumber + 1) / totalChunks * 100).toFixed(1);
            progressBar.style.width = progress + '%';
            progressText.textContent = `Uploading ${file.name}: ${progress}%`;

            const result = await uploadChunk(file, chunkNumber, totalChunks, fileId);
            
            if (result.status === 'complete') {
                progressBar.style.width = '100%';
                progressText.textContent = result.message;
                
                if (result.success && file.type.indexOf('zip') !== -1) {
                    // Start checking upload status for ZIP files
                    startStatusCheck();
                } else if (!result.success) {
                    throw new Error(result.message);
                }
                break;
            }
        }
    }

    async function checkUploadStatus() {
        try {
            const response = await fetch('/admin/uploadStatus');
            if (!response.ok) {
                throw new Error('Failed to get status');
            }
            
            const uploads = await response.json();
            if (uploads.length > 0) {
                uploadStatus.classList.remove('hidden');
                renderUploadStatus(uploads);
                
                // Stop checking if all uploads are complete
                const pending = uploads.some(u => u.status === 'pending' || u.status === 'processing');
                if (!pending) {
                    stopStatusCheck();
                }
            }
        } catch (error) {
            console.error('Error checking upload status:', error);
        }
    }

    function renderUploadStatus(uploads) {
        uploadList.innerHTML = uploads.map(upload => `
            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-semibold">${upload.filename}</h3>
                        <p class="text-sm text-gray-600">Status: ${upload.status}</p>
                        ${upload.processed ? `<p class="text-sm text-gray-600">Processed: ${upload.processed} images</p>` : ''}
                        ${upload.errors ? `<p class="text-sm text-red-600">Errors: ${upload.errors}</p>` : ''}
                        ${upload.message ? `<p class="text-sm mt-2 ${upload.errors ? 'text-red-600' : 'text-gray-600'}">${upload.message}</p>` : ''}
                    </div>
                    <div class="text-right text-sm text-gray-500">
                        <div>Started: ${new Date(upload.created_at).toLocaleString()}</div>
                        ${upload.completed_at ? `<div>Completed: ${new Date(upload.completed_at).toLocaleString()}</div>` : ''}
                    </div>
                </div>
            </div>
        `).join('');
    }

    function startStatusCheck() {
        if (!statusCheckInterval) {
            checkUploadStatus();
            statusCheckInterval = setInterval(checkUploadStatus, 5000);
        }
    }

    function stopStatusCheck() {
        if (statusCheckInterval) {
            clearInterval(statusCheckInterval);
            statusCheckInterval = null;
        }
    }

    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const files = fileInput.files;

        if (files.length === 0) {
            alert('Please select files to upload');
            return;
        }

        progressDiv.classList.remove('hidden');

        for (let file of files) {
            try {
                // Always use chunked upload for ZIP files or large files
                if (file.type.indexOf('zip') !== -1 || file.size > maxChunkSize) {
                    await uploadFile(file);
                } else {
                    // Use regular upload for small files
                    const formData = new FormData();
                    formData.append('memes[]', file);
                    
                    progressBar.style.width = '0%';
                    progressText.textContent = `Uploading ${file.name}...`;
                    
                    const response = await fetch('/admin/upload', {
                        method: 'POST',
                        body: formData
                    });
                    
                    if (!response.ok) {
                        throw new Error('Upload failed');
                    }
                    
                    progressBar.style.width = '100%';
                    progressText.textContent = `${file.name} uploaded successfully`;
                }
            } catch (error) {
                alert('Upload failed: ' + error.message);
                break;
            }
        }
    });

    fileInput.addEventListener('change', function(e) {
        const files = e.target.files;
        const maxSize = 100 * 1024 * 1024; // 100MB for ZIP files
        const maxImageSize = 5 * 1024 * 1024; // 5MB for individual images
        let oversizedFiles = [];

        for (let file of files) {
            const isZip = file.type.indexOf('zip') !== -1;
            const sizeLimit = isZip ? maxSize : maxImageSize;

            if (file.size > sizeLimit) {
                oversizedFiles.push(`${file.name} (${(file.size / 1024 / 1024).toFixed(1)}MB)`);
            }
        }

        if (oversizedFiles.length > 0) {
            alert(`The following files exceed the size limit:\n${oversizedFiles.join('\n')}`);
            e.target.value = '';
        }
    });
});
</script>
