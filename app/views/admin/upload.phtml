<script>
document.querySelector('input[type="file"]').addEventListener('change', function(e) {
    const files = e.target.files;
    const maxSize = 50 * 1024 * 1024; // 50MB for ZIP files
    const maxImageSize = 5 * 1024 * 1024; // 5MB for individual images
    let oversizedFiles = [];

    for (let file of files) {
        const isZip = file.type.indexOf('zip') !== -1;
        const sizeLimit = isZip ? maxSize : maxImageSize;

        console.log(isZip);
        
        if (file.size > sizeLimit) {
            oversizedFiles.push(`${file.name} (${isZip ? '50MB' : '5MB'} limit)`);
        }
    }

    if (oversizedFiles.length > 0) {
        alert('The following files exceed the size limit:\n' + oversizedFiles.join('\n'));
        e.target.value = ''; // Clear the file input
    }
});
</script>
