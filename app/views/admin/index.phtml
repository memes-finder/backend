                            <?php if ($meme['duration']): ?>
                                <div class="position-absolute bottom-0 end-0 bg-dark bg-opacity-75 text-white px-2 py-1 m-2 rounded">
                                    <?= gmdate("i:s", (int)$meme['duration']) ?>
