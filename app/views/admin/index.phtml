                    <a href="?type=video<?= $status ? "&status=$status" : '' ?><?= $searchQuery ? "&q=" . urlencode($searchQuery) : '' ?>" class="btn <?= $memeType === 'video' ? 'btn-primary' : 'btn-outline-primary' ?>">Videos</a>
