    <?php if (count($memes->items) === 0 && empty($searchQuery)): ?>
        <div class="alert alert-info">
            No memes found. <?php if ($status): ?>Try viewing all memes instead of filtering by status.<?php endif; ?>
        </div>
    <?php endif; ?>

    <!-- Pagination -->
    <?php if ($memes->total_items > 0): ?>
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <!-- Previous button -->
            <li class="page-item <?= $currentPage == 1 ? 'disabled' : '' ?>">
                <a class="page-link" href="?page=<?= max(1, $currentPage - 1) ?><?= $status ? "&status=$status" : '' ?><?= $searchQuery ? "&q=" . urlencode($searchQuery) : '' ?><?= $memeType ? "&type=$memeType" : '' ?>">Previous</a>
            </li>

            <?php
            $totalPages = ceil($memes->total_items / $memes->limit);
            $currentPage = $memes->current;
            $range = 2; // Show 2 pages before and after current page
            
            // Calculate range of pages to show
            $startPage = max(1, $currentPage - $range);
            $endPage = min($totalPages, $currentPage + $range);
            
            // Always show first page
            if ($startPage > 1) {
                echo '<li class="page-item">';
                echo '<a class="page-link" href="?page=1' . 
                     ($status ? "&status=$status" : '') . 
                     ($searchQuery ? "&q=" . urlencode($searchQuery) : '') . 
                     ($memeType ? "&type=$memeType" : '') . 
                     '">1</a>';
                echo '</li>';
                
                if ($startPage > 2) {
                    echo '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
            }
            
            // Show page numbers
            for ($i = $startPage; $i <= $endPage; $i++) {
                echo '<li class="page-item ' . ($currentPage == $i ? 'active' : '') . '">';
                echo '<a class="page-link" href="?page=' . $i . 
                     ($status ? "&status=$status" : '') . 
                     ($searchQuery ? "&q=" . urlencode($searchQuery) : '') . 
                     ($memeType ? "&type=$memeType" : '') . 
                     '">' . $i . '</a>';
                echo '</li>';
            }
            
            // Always show last page
            if ($endPage < $totalPages) {
                if ($endPage < $totalPages - 1) {
                    echo '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
                echo '<li class="page-item">';
                echo '<a class="page-link" href="?page=' . $totalPages . 
                     ($status ? "&status=$status" : '') . 
                     ($searchQuery ? "&q=" . urlencode($searchQuery) : '') . 
                     ($memeType ? "&type=$memeType" : '') . 
                     '">' . $totalPages . '</a>';
                echo '</li>';
            }
            ?>
            
            <!-- Next button -->
            <li class="page-item <?= $currentPage >= $totalPages ? 'disabled' : '' ?>">
                <a class="page-link" href="?page=<?= min($totalPages, $currentPage + 1) ?><?= $status ? "&status=$status" : '' ?><?= $searchQuery ? "&q=" . urlencode($searchQuery) : '' ?><?= $memeType ? "&type=$memeType" : '' ?>">Next</a>
            </li>
        </ul>
    </nav>
    <?php endif; ?>
</div>
