<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <form method="GET" class="d-flex gap-2">
                <?php if ($status): ?>
                <input type="hidden" name="status" value="<?= $status ?>">
                <?php endif; ?>
                
                <div class="flex-grow-1">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Search by tag..." value="<?= $this->escaper->escapeHtmlAttr($searchQuery ?? '') ?>">
                        <button class="btn btn-primary" type="submit">Search</button>
                        <?php if (!empty($searchQuery)): ?>
                        <a href="<?= $status ? "?status=$status" : '/' ?>" class="btn btn-outline-secondary">Clear</a>
                        <?php endif; ?>
                    </div>
                </div>

                <div class="btn-group">
                    <a href="/admin" class="btn <?= empty($status) ? 'btn-primary' : 'btn-outline-primary' ?>">All</a>
                    <a href="?status=pending" class="btn <?= $status === 'pending' ? 'btn-primary' : 'btn-outline-primary' ?>">Pending</a>
                    <a href="?status=approved" class="btn <?= $status === 'approved' ? 'btn-primary' : 'btn-outline-primary' ?>">Approved</a>
                </div>
            </form>
        </div>
    </div>

    <?php if (!empty($searchQuery)): ?>
    <div class="alert alert-info">
        Search results for: <strong><?= $this->escaper->escapeHtml($searchQuery) ?></strong>
        <?php if ($memes->total_items === 0): ?>
            <br>No memes found.
        <?php else: ?>
            <br>Found <?= $memes->total_items ?> meme(s).
        <?php endif; ?>
    </div>
    <?php endif; ?>

    <div class="row">
        <?php foreach ($memes->items as $meme): ?>
            <?php 
            // Convert array to model instance
            $memeModel = new \App\Models\Memes();
            $memeModel->assign($meme);
            ?>
            <div class="col-md-6 col-lg-4">
                <div class="card meme-card">
                    <img src="<?= $memeModel->getPublicUrl() ?>" class="card-img-top meme-preview" alt="Meme">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">ID: <?= $meme['id'] ?></h6>
                        <p class="card-text">
                            Status: 
                            <span class="badge bg-<?= $meme['status'] === 'approved' ? 'success' : 'warning' ?>">
                                <?= ucfirst($meme['status']) ?>
                            </span>
                        </p>
                        <div class="mb-2">
                            <?php foreach ($memeModel->getTags() as $tag): ?>
                                <span class="badge bg-info tag-badge">
                                    <?= $tag->tag ?> (<?= strtoupper($tag->language) ?>)
                                </span>
                            <?php endforeach; ?>
                        </div>
                        <div class="btn-group">
                            <a href="/admin/meme/<?= $meme['id'] ?>" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a href="/admin/tags/<?= $meme['id'] ?>" class="btn btn-info btn-sm">
                                <i class="fas fa-tags"></i> Manage Tags
                            </a>
                            <a href="/admin/delete/<?= $meme['id'] ?>" 
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this meme?');">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if (count($memes->items) === 0 && empty($searchQuery)): ?>
        <div class="alert alert-info">
            No memes found. <?php if ($status): ?>Try viewing all memes instead of filtering by status.<?php endif; ?>
        </div>
    <?php endif; ?>

    <!-- Pagination -->
    <?php if ($memes->total_items > 0): ?>
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item <?= $memes->current == 1 ? 'disabled' : '' ?>">
                <a class="page-link" href="?page=<?= $memes->before ?>&status=<?= $status ?>">Previous</a>
            </li>
            <?php for ($i = 1; $i <= ceil($memes->total_items / $memes->limit); $i++): ?>
                <li class="page-item <?= $memes->current == $i ? 'active' : '' ?>">
                    <a class="page-link" href="?page=<?= $i ?>&status=<?= $status ?>"><?= $i ?></a>
                </li>
            <?php endfor; ?>
            <li class="page-item <?= $memes->current >= ceil($memes->total_items / $memes->limit) ? 'disabled' : '' ?>">
                <a class="page-link" href="?page=<?= $memes->next ?>&status=<?= $status ?>">Next</a>
            </li>
        </ul>
    </nav>
    <?php endif; ?>
</div>
