                                <?= ucfirst($meme['status']) ?>
                            </span>
                            <span class="text-muted" title="Total views">
                                <i class="fas fa-eye"></i> <?= number_format($meme['view_count']) ?>
                            </span>
                        </div>
                        <p class="card-text small text-muted">
                            Added: <?= (new DateTime($meme['created_at']))->format('Y-m-d H:i') ?>
                        </p>
                        <div class="btn-group w-100">
                            <a href="/admin/meme/<?= $meme['id'] ?>" class="btn btn-primary btn-sm">
