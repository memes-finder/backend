<!-- Add Sortable.js library -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var el = document.getElementById('notificationsTableBody');
    var sortable = new Sortable(el, {
        animation: 150,
        handle: '.handle',
        onEnd: function() {
            // Get new order
            var items = [];
            document.querySelectorAll('.sortable-row').forEach(function(row, index) {
                items.push({
                    id: parseInt(row.dataset.id),
                    order: index + 1
                });
            });

            // Save new order
            fetch('/admin/notifications/order', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ items: items })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status !== 'success') {
                    alert('Failed to save order: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to save order');
            });
        }
    });
});
</script>
